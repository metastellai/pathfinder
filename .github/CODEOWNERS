# Code owners for Pathfinder. When several lines match, the last one wins.
# Enforced once branch protection on main enables "Require review from Code Owners".
# Every team here needs write access to the repo, or GitHub skips its lines.

# Everything not matched below, including app/. The maintainers team includes the
# new grads, so they can approve each other's application PRs.
*                       @metastellai/contributor

# Durable code: built to outlast the application, so a senior reviewer is required.
/packages/              @metastellai/reviewer
/contracts/             @metastellai/reviewer
/acceptance/            @metastellai/reviewer
/mappings/              @metastellai/reviewer
/templates/             @metastellai/reviewer

# Process, agent rules, CI and deployment.
/AGENTS.md              @metastellai/leader
/CLAUDE.md              @metastellai/leader
/.agents/               @metastellai/leader
/.claude/               @metastellai/leader
/.github/               @metastellai/leader
/deploy/                @metastellai/leader

# Scope, architecture and the command contract.
/README.md              @metastellai/leader
/ARCHITECTURE.md        @metastellai/leader
/justfile               @metastellai/leader

# Specs and decisions shape the code, so a senior reviewer signs them off.
/specs/                 @metastellai/reviewer
/docs/decisions/        @metastellai/reviewer

# Dependency manifests anywhere in the tree. Licence sign-off (AGENTS.md) happens here,
# so these lines come last and override the durable-code lines above.
pyproject.toml          @metastellai/leader
uv.lock                 @metastellai/leader
package.json            @metastellai/leader
package-lock.json       @metastellai/leader
pnpm-lock.yaml          @metastellai/leader

# Quality gates: changing them needs sign-off (AGENTS.md, "Ask first").
.pre-commit-config.yaml @metastellai/leader
ruff.toml               @metastellai/leader
.ruff.toml              @metastellai/leader
mypy.ini                @metastellai/leader
.mypy.ini               @metastellai/leader
pytest.ini              @metastellai/leader
setup.cfg               @metastellai/leader
tsconfig*.json          @metastellai/leader
eslint.config.*         @metastellai/leader
.eslintrc*              @metastellai/leader
