# Code owners for Pathfinder. When several lines match, the last one wins.
# Enforced once branch protection on main enables "Require review from Code Owners".
# Every team here needs write access to the repo, or GitHub skips its lines.

# Everything not matched below, including app/. The maintainers team includes the
# new grads, so they can approve each other's application PRs.
*                       @metastellai/pathfinder-maintainers

# Durable code: built to outlast the application, so a senior reviewer is required.
/packages/              @metastellai/pathfinder-core
/contracts/             @metastellai/pathfinder-core
/acceptance/            @metastellai/pathfinder-core
/mappings/              @metastellai/pathfinder-core
/templates/             @metastellai/pathfinder-core

# Process, agent rules, CI and deployment.
/AGENTS.md              @metastellai/pathfinder-leads
/CLAUDE.md              @metastellai/pathfinder-leads
/.agents/               @metastellai/pathfinder-leads
/.claude/               @metastellai/pathfinder-leads
/.github/               @metastellai/pathfinder-leads
/deploy/                @metastellai/pathfinder-leads

# Scope, architecture and the command contract.
/README.md              @metastellai/pathfinder-leads
/ARCHITECTURE.md        @metastellai/pathfinder-leads
/justfile               @metastellai/pathfinder-leads

# Specs and decisions shape the code, so a senior reviewer signs them off.
/specs/                 @metastellai/pathfinder-core
/docs/decisions/        @metastellai/pathfinder-core

# Dependency manifests anywhere in the tree. Licence sign-off (AGENTS.md) happens here,
# so these lines come last and override the durable-code lines above.
pyproject.toml          @metastellai/pathfinder-leads
uv.lock                 @metastellai/pathfinder-leads
package.json            @metastellai/pathfinder-leads
package-lock.json       @metastellai/pathfinder-leads
pnpm-lock.yaml          @metastellai/pathfinder-leads

# Quality gates: changing them needs sign-off (AGENTS.md, "Ask first").
.pre-commit-config.yaml @metastellai/pathfinder-leads
ruff.toml               @metastellai/pathfinder-leads
.ruff.toml              @metastellai/pathfinder-leads
mypy.ini                @metastellai/pathfinder-leads
.mypy.ini               @metastellai/pathfinder-leads
pytest.ini              @metastellai/pathfinder-leads
setup.cfg               @metastellai/pathfinder-leads
tsconfig*.json          @metastellai/pathfinder-leads
eslint.config.*         @metastellai/pathfinder-leads
.eslintrc*              @metastellai/pathfinder-leads
